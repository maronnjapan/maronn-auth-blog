{
  "name": "@maronn-auth-blog/web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "pnpm content && astro dev",
    "build": "pnpm content && astro build",
    "preview": "pnpm content && astro preview",
