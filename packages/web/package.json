    "deploy:production": "pnpm build && wrangler deploy --env production"
  },
  "dependencies": {
    "@astrojs/react": "^3.0.9",
    "astro": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zenn-content-css": "^0.3.1",
    "zenn-markdown-html": "^0.1.162"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "js-yaml": "^4.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.3.3",
    "vitest": "^1.2.1",
    "wrangler": "^4.59.2"
  }
}
