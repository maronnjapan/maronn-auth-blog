---
import BaseLayout from './BaseLayout.astro';
import ArticleList from '../islands/ArticleList';
import SearchBar from '../islands/SearchBar';
import CategoryFilter from '../islands/CategoryFilter';
import TopicCloud from '../islands/TopicCloud';
import Pagination from '../islands/Pagination';
import { categoryFacets, topicFacets } from '../lib/content';
import type { ArticleMeta, TargetCategory } from '../lib/content';

export interface Props {
  heading: string;
  pageTitle: string;
  description?: string;
  articles: ArticleMeta[];
  currentPage?: number;
  totalPages?: number;
  /** ページ番号順のリンク先。ページャを出さない一覧では省略する */
  pageUrls?: string[];
  selectedCategory?: TargetCategory;
  selectedTopic?: string;
  /** 絞り込み中であることを伝える一文 */
  filterNotice?: string;
}

const {
  heading,
  pageTitle,
  description,
  articles,
  currentPage = 1,
  totalPages = 1,
  pageUrls = ['/'],
  selectedCategory,
  selectedTopic,
  filterNotice,
} = Astro.props;

const categories = categoryFacets();
const topics = topicFacets().slice(0, 30);
---

<BaseLayout title={pageTitle} description={description}>
  <div class="container">
    <div class="header-section">
      <h1>{heading}</h1>
      <div class="search-wrapper">
        <SearchBar client:load />
      </div>
    </div>

    <div class="layout">
      <main class="main-content">
        {filterNotice && (
          <div class="filter-notice">
            <p>
              {filterNotice}
              <a href="/" class="clear-filter">クリア</a>
            </p>
          </div>
        )}
        <ArticleList articles={articles} />
        <Pagination currentPage={currentPage} totalPages={totalPages} pageUrls={pageUrls} />
      </main>

      <aside class="sidebar">
        <CategoryFilter categories={categories} selectedCategory={selectedCategory} />
        <TopicCloud topics={topics} selectedTopic={selectedTopic} />
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .header-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  h1 {
    font-size: 2rem;
    color: #333;
    margin: 0;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .search-wrapper {
    flex-shrink: 0;
  }

  .layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2rem;
  }

  .main-content {
    min-width: 0;
  }

  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-width: 0;
  }

  .filter-notice {
    background: #e6f0ff;
    padding: 0.75rem 1rem;
    border-radius: 4px;
    margin-bottom: 1rem;
  }

  .filter-notice p {
    margin: 0;
    color: #0066cc;
  }

  .clear-filter {
    margin-left: 0.5rem;
    color: #666;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .sidebar {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 0.75rem;
    }

    .header-section {
      margin-bottom: 1.5rem;
      gap: 0.75rem;
    }

    h1 {
      font-size: 1.5rem;
    }

    .layout {
      gap: 1.25rem;
    }

    .sidebar {
      gap: 1rem;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 0.5rem;
    }

    .header-section {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 1.25rem;
    }

    h1 {
      font-size: 1.25rem;
    }

    .search-wrapper {
      width: 100%;
    }

    .clear-filter {
      display: block;
      margin-left: 0;
      margin-top: 0.25rem;
    }
  }
</style>
