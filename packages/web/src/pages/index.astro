---
import ArticleIndexLayout from '../layouts/ArticleIndexLayout.astro';
import { articles } from '../lib/content';
import { pageHref, slicePage, totalPageCount } from '../lib/paginate';

const page = slicePage(articles, 1);
const pageUrls = Array.from({ length: totalPageCount(articles.length) }, (_, i) => pageHref(i + 1));
---

<ArticleIndexLayout
  heading="最新の記事"
  pageTitle="Auth Vault"
  articles={page.items}
  currentPage={page.currentPage}
  totalPages={page.totalPages}
  pageUrls={pageUrls}
/>
